---
import Base from '../layouts/Base.astro';
import Galleria from '../components/Galleria.astro';
import { useT, url, type Lingua } from '../i18n/ui';

interface Props { lang: Lingua }
const { lang } = Astro.props;
const t = useT(lang);
---
<Base lang={lang} pagina="home" titolo={t('home.titolo')} descrizione={t('home.sottotitolo')}>
  <section class="hero">
    <div class="contenitore">
      <h1>{t('home.titolo')}</h1>
      <p>{t('home.sottotitolo')}</p>
      <a class="bottone" href={url('contatti', lang)}>{t('home.cta')}</a>
    </div>
  </section>
  {/* TODO: sezioni "La nostra struttura" e "Scopri la Val di Chio" */}
  <section class="sezione contenitore">
    <Galleria limite={6} testoVuoto={t('galleria.vuota')} />
  </section>
</Base>

<style>
  .hero { padding: 6rem 0; text-align: center; background: var(--c-bordo); }
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 0 0 .5rem; }
</style>
