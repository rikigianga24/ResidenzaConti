---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import IconaNatura from '../components/IconaNatura.astro';
import NomeHero from '../components/NomeHero.astro';
import Servizi from '../components/Servizi.astro';
import Cipressi from '../components/Cipressi.astro';
import BottoniContatto from '../components/BottoniContatto.astro';
import { url, type Lingua } from '../i18n/lingue';
import { useT } from '../i18n/ui';
import { struttura } from '../data/struttura';
import { esisteFoto } from '../data/foto';
import { luoghi, nomeLuogo, recensioni, recensioniPerLingua } from '../data/contenuti';

interface Props { lang: Lingua; voce: CollectionEntry<'pagine'> }
const { lang, voce } = Astro.props;
const d = voce.data;
const t = useT(lang);
const hero = d.hero!, nastro = d.nastro!, valle = d.valle!, casa = d.casa!, piscina = d.piscina!, fuori = d.fuori!, storia = d.storia!, dint = d.dintorni!, cont = d.contatti!;

// Foto dell'hero (a tutta larghezza, quindi orizzontale): quella serale con le luci accese,
// se è stata aggiunta; finché non c'è, il viale di cipressi nella valle.
const fotoHero = esisteFoto('casa/00-casa-sera') ? 'casa/00-casa-sera' : 'casa/05-viale-cipressi';
// Le tre carte della valle: natura, passeggiate, rilassamento
const carteValle = [
  { icona: 'ulivo', foto: 'giardino/06-tramonto-ulivi' },
  { icona: 'viale', foto: 'casa/05-viale-cipressi' },
  { icona: 'amaca', foto: 'giardino/04-amaca' },
] as const;
const fotoStanze = ['casa/07-soggiorno-cucina', 'casa/09-camera-1', null, 'casa/13-camera-2-travi', 'casa/06-soggiorno'];
// rapporti diversi per ogni foto: una grande, due più piccole, poi le altre (vedi .mosaico in global.css)
const rapportiStanze = ['r-4-5', 'r-4-3', 'r-4-3', 'r-4-3', 'r-16-9'];
const rapportiValle = ['r-4-5', 'r-4-3', 'r-1-1'];
const recInEvidenza = recensioniPerLingua(lang)[0];
---
<Base lang={lang} pagina="home" seoTitolo={d.seoTitolo} descrizione={d.descrizione} fotoOg={fotoHero} schema>
  <section class="hero">
    <div class="hero-foto"><Foto id={fotoHero} lang={lang} sizes="100vw" subito larga /></div>
    <div class="wrap hero-testo">
      <p class="eyebrow">{hero.eyebrow}</p>
      <NomeHero />
      <p class="sub">{hero.sottotitolo}</p>
      <div class="ctas">
        <a class="btn btn-vino" href={url('disponibilita', lang)}>{t('cta.disponibilita')}</a>
        <a class="btn btn-filo" href={url('casa', lang)}>{t('cta.scopri')}</a>
      </div>
    </div>
  </section>

  <div class="nastro" aria-hidden="true">
    <ul>{nastro.map((v) => <li>{v}</li>)}</ul>
  </div>

  <section class="sec" id="valle">
    <div class="wrap">
      <div class="intro-valle">
        <div>
          <h2 class="h2">{valle.titolo}</h2>
          <p class="lead">{valle.testo}</p>
        </div>
        <div class="ph entra r-4-3"><div class="img"><Foto id="giardino/10-prato-cipressi" lang={lang} sizes="(min-width: 1240px) 700px, (min-width: 720px) 58vw, 92vw" /></div></div>
      </div>
      <ul class="valle">
        {valle.punti.map((p, i) => (
          <li class="natura">
            <div class={`ph entra ${rapportiValle[i]}`}><div class="img"><Foto id={carteValle[i].foto} lang={lang} sizes="(min-width: 1240px) 500px, (min-width: 720px) 40vw, 92vw" /></div></div>
            <h3><IconaNatura nome={carteValle[i].icona} />{p.titolo}</h3>
            <p>{p.testo}</p>
          </li>
        ))}
      </ul>
      <p class="motto">{valle.motto}</p>
    </div>
  </section>

  <section class="sec sec-pietra" id="casa">
    <div class="wrap">
      <h2 class="h2">{casa.titolo}</h2>
      <p class="lead">{casa.testo}</p>
      <ul class="mosaico">
        {casa.stanze.map((testo, i) => (
          <li class="stanza">
            <figure>
              <div class={`ph entra ${rapportiStanze[i]}`}>
                {fotoStanze[i]
                  ? <div class="img"><Foto id={fotoStanze[i]!} lang={lang} sizes="(min-width: 1040px) 70vw, 92vw" /></div>
                  : <span class="ph-lbl">[FOTO DA FORNIRE]</span>}
              </div>
              <figcaption>{testo}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <div class="onesta">
        {casa.onesta.map((o) => <p><b>{o.titolo}</b> {o.testo}</p>)}
      </div>
      <div class="links">
        <a class="link" href={url('casa', lang)}>{t('link.tuttoCasa')}</a>
        <a class="link" href={url('galleria', lang)}>{t('link.galleria')}</a>
      </div>
    </div>
  </section>

  <section class="piscina" id="piscina">
    <div class="panorama"><Foto id="piscina/04-piscina-cipressi" lang={lang} sizes="100vw" larga /></div>
    <div class="wrap piscina-grid">
      <div>
        <h2 class="h2">{piscina.titolo}</h2>
        <p class="lead">{piscina.testo}</p>
        <ul class="dati">
          {piscina.dati.map((r) => <li><b>{r.etichetta}</b><span>{r.valore}</span></li>)}
        </ul>
      </div>
      <div class="foto-duo">
        <div class="ph entra r-3-4"><div class="img"><Foto id="piscina/01-piscina-ulivi" lang={lang} sizes="(min-width: 1040px) 20vw, 46vw" /></div></div>
        <div class="ph entra r-4-5"><div class="img"><Foto id="piscina/03-piscina-cielo" lang={lang} sizes="(min-width: 1040px) 20vw, 46vw" /></div></div>
      </div>
    </div>
  </section>

  <section class="sec sec-0">
    <div class="wrap">
      <h2 class="h2">{fuori.titolo}</h2>
      <p class="lead">{fuori.testo}</p>
      <Servizi servizi={fuori.servizi} />
    </div>
  </section>

  <section class="sec scuro" id="storia">
    <div class="wrap">
      <h2 class="h2">{storia.titolo}</h2>
      <p class="lead lead-largo">{storia.testo}</p>
      <Cipressi />
      <ul class="valle inverso">
        <li class="natura">
          <div class="ph entra r-3-4"><div class="img"><Foto id="casa/05-viale-cipressi" lang={lang} sizes="(min-width: 1240px) 400px, (min-width: 720px) 30vw, 92vw" /></div></div>
          <h3><IconaNatura nome="viale" />{storia.viale}</h3>
        </li>
        <li class="natura">
          <div class="ph entra r-1-1"><div class="img"><Foto id="casa/03-cappella" lang={lang} sizes="(min-width: 1240px) 480px, (min-width: 720px) 36vw, 92vw" /></div></div>
          <h3><IconaNatura nome="cappella" />{storia.cappella}</h3>
        </li>
        <li class="natura">
          <div class="ph entra r-4-3"><div class="img"><Foto id="casa/02-casa-portico-esterno" lang={lang} sizes="(min-width: 1240px) 600px, (min-width: 720px) 44vw, 92vw" /></div></div>
          <h3><IconaNatura nome="portico" />{storia.portico}</h3>
        </li>
      </ul>
      <a class="link" href={url('storia', lang)}>{t('link.storia')}</a>
    </div>
  </section>

  <section class="sec" id="dintorni">
    <div class="wrap">
      <h2 class="h2">{dint.titolo}</h2>
      <p class="lead lead-largo">{dint.testo}</p>
      <ul class="luoghi">
        {luoghi.map((l) => (
          <li class="luogo">
            <div class="ph r-1-1"><span class="ph-lbl">[FOTO]</span></div>
            <h3>{nomeLuogo(l, lang)}</h3>
            <p>{l.minutiAuto ? `${l.minutiAuto} min ${t('auto.tempo')}` : t('foot.daFornire')}</p>
          </li>
        ))}
      </ul>
      <a class="link" href={url('dintorni', lang)}>{t('link.dintorni')}</a>
    </div>
  </section>

  <section class="sec sec-0">
    <div class="wrap">
      <div class="rec">
        <h2 class="h2 h2-piccolo">{t('rec.titolo')}</h2>
        {recInEvidenza ? (
          <>
            <blockquote lang={recInEvidenza.lingua !== 'altro' ? recInEvidenza.lingua : undefined}>“{recInEvidenza.testo}”</blockquote>
            <p class="muted">{recInEvidenza.nome}, {recInEvidenza.paese}, {recInEvidenza.data}</p>
          </>
        ) : (
          <p>{t('rec.nessuna')}</p>
        )}
        <div class="voto">
          <b>{recensioni.punteggioMedio ?? '[–]'}</b>
          <span>{t('rec.media')}</span>
        </div>
        <a class="link" href={url('recensioni', lang)}>{t('pag.recensioni')}</a>
      </div>
    </div>
  </section>

  <section class="sec sec-0" id="contatti">
    <div class="wrap contatti">
      <div>
        <h2 class="h2">{cont.titolo}</h2>
        <p class="p">{cont.testo} {struttura.bookingUrl && <a href={struttura.bookingUrl} rel="noopener">{cont.bookingTesto}</a>}</p>
      </div>
      <BottoniContatto lang={lang} lungo email />
    </div>
  </section>
</Base>
