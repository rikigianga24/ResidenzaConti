---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { useT, type Lingua } from '../i18n/ui';
import { struttura } from '../data/struttura';

interface Props { lang: Lingua }
const { lang } = Astro.props;
const t = useT(lang);
const c = struttura.contatti;
---
<Base lang={lang} pagina="contatti" titolo={t('contatti.titolo')}>
  <section class="sezione contenitore">
    <h1>{t('contatti.titolo')}</h1>
    <ul class="contatti">
      {c.email && <li><a href={`mailto:${c.email}`}>{c.email}</a></li>}
      {c.telefono && <li><a href={`tel:+${c.telefono}`}>+{c.telefono}</a> · <a href={`https://wa.me/${c.telefono}`}>WhatsApp</a></li>}
      {c.indirizzo && <li>{c.indirizzo}</li>}
    </ul>
    <ContactForm lang={lang} />
    {/* TODO: mappa */}
  </section>
</Base>

<style>
  .contatti { list-style: none; padding: 0; margin-bottom: 2rem; }
</style>
