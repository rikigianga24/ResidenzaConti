---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import TestataPagina from '../components/TestataPagina.astro';
import BottoniContatto from '../components/BottoniContatto.astro';
import { useT } from '../i18n/ui';
import { url, type Lingua } from '../i18n/lingue';
import { struttura, indirizzoCompleto } from '../data/struttura';

interface Props { lang: Lingua; voce: CollectionEntry<'pagine'> }
const { lang, voce } = Astro.props;
const d = voce.data;
const t = useT(lang);
const s = struttura;
---
<Base lang={lang} pagina="contatti" seoTitolo={d.seoTitolo} descrizione={d.descrizione}>
  <TestataPagina titolo={d.titolo} intro={d.intro} />
  <section class="sec sec-0">
    <div class="wrap">
      <BottoniContatto lang={lang} lungo email booking={false} />
      {s.bookingUrl && <p class="p"><a class="link" href={s.bookingUrl} rel="noopener">{t('cta.booking')}</a></p>}
      <div class="dotazioni">
        <section>
          <h2>{t('foot.contatti')}</h2>
          <ul>
            <li>WhatsApp / {t('cta.chiama')}: <a href={`tel:${s.telefono}`}>{s.telefonoLeggibile}</a></li>
            <li><a href={`mailto:${s.email}`}>{s.email}</a></li>
            <li><a href={s.instagram} rel="noopener">Instagram</a> · <a href={s.tiktok} rel="noopener">TikTok</a></li>
          </ul>
        </section>
        <section>
          <h2>{t('foot.indirizzo')}</h2>
          <p>{indirizzoCompleto}</p>
          <a class="link" href={url('arrivare', lang)}>{t('pag.arrivare')}</a>
        </section>
      </div>
    </div>
  </section>
</Base>
