---
import Base from '../layouts/Base.astro';
import Galleria from '../components/Galleria.astro';
import { useT, type Lingua } from '../i18n/ui';

interface Props { lang: Lingua }
const { lang } = Astro.props;
const t = useT(lang);
---
<Base lang={lang} pagina="galleria" titolo={t('galleria.titolo')}>
  <section class="sezione contenitore">
    <h1>{t('galleria.titolo')}</h1>
    <Galleria testoVuoto={t('galleria.vuota')} />
  </section>
</Base>
