---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TestataPagina from '../components/TestataPagina.astro';
import ChiamataContatti from '../components/ChiamataContatti.astro';
import Foto from '../components/Foto.astro';
import Lightbox from '../components/Lightbox.astro';
import type { Lingua } from '../i18n/lingue';
import { useT, type ChiaveUi } from '../i18n/ui';
import { tutteLeFoto, type Area } from '../data/foto';

interface Props { lang: Lingua; voce: CollectionEntry<'pagine'> }
const { lang, voce } = Astro.props;
const d = voce.data;
const t = useT(lang);
const aree: Area[] = ['casa', 'giardino', 'piscina', 'dintorni', 'stagioni'];
// Una foto "grande" per area (orizzontale, a tutta larghezza tra le colonne): la prima della lista.
const grandi = ['casa/00-casa-sera', 'giardino/10-prato-cipressi', 'piscina/04-piscina-cipressi'];
// Rapporti a rotazione: orizzontale, verticale, quadrata... così le foto non hanno mai tutte la stessa misura.
const rapporti = ['r-4-3', 'r-3-4', 'r-1-1', 'r-3-4', 'r-4-3', 'r-4-5', 'r-1-1', 'r-4-3'];
// per ogni foto anche una versione grande (1800px) da aprire nella lightbox
const tutte = (await Promise.all(
  aree.flatMap((area) => {
    const dellArea = tutteLeFoto.filter((f) => f.area === area);
    // la foto grande va per prima nel suo gruppo
    dellArea.sort((a, b) => Number(grandi.includes(b.id)) - Number(grandi.includes(a.id)));
    return dellArea.map(async (f) => ({
      ...f,
      grande: (await getImage({ src: f.src, width: Math.min(1800, f.src.width), format: 'webp', quality: 72 })).src,
    }));
  }),
));
// i filtri compaiono solo per le aree che hanno foto (dintorni e stagioni: quando ci saranno foto proprie)
const areeConFoto = aree.filter((a) => tutte.some((f) => f.area === a));
let n = 0;
---
<Base lang={lang} pagina="galleria" seoTitolo={d.seoTitolo} descrizione={d.descrizione} fotoOg="piscina/01-piscina-ulivi">
  <TestataPagina titolo={d.titolo} intro={d.intro} />
  <section class="sec sec-0">
    <div class="wrap">
      {/* i filtri si attivano con JavaScript (scripts/galleria.ts): senza, restano nascosti e si vedono tutte le foto */}
      <div class="filtri" role="group" aria-label={t('galleria.filtri')} hidden>
        <button type="button" class="filtro" data-filtro="tutto" aria-pressed="true">{t('galleria.tutto')}</button>
        {areeConFoto.map((a) => <button type="button" class="filtro" data-filtro={a} aria-pressed="false">{t(`galleria.${a}` as ChiaveUi)}</button>)}
      </div>
      <ul class="masonry">
        {tutte.map((f) => {
          const grande = grandi.includes(f.id);
          const rapporto = grande ? 'r-21-9' : rapporti[n++ % rapporti.length];
          return (
            <li class={grande ? 'mas grande' : 'mas'} data-area={f.area}>
              <a href={f.grande} data-lightbox class={rapporto}>
                <Foto id={f.id} lang={lang} sizes={grande ? '(min-width: 1240px) 1170px, 92vw' : '(min-width: 1040px) 25vw, (min-width: 720px) 33vw, 50vw'} />
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
  <Lightbox lang={lang} />
  <ChiamataContatti lang={lang} />
</Base>
<script>
  import { avviaFiltri } from '../scripts/galleria';
  avviaFiltri();
</script>
