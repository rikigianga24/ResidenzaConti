---
import { render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TestataPagina from '../components/TestataPagina.astro';
import ChiamataContatti from '../components/ChiamataContatti.astro';
import Foto from '../components/Foto.astro';
import { url, type Lingua } from '../i18n/lingue';
import { useT } from '../i18n/ui';
import { struttura } from '../data/struttura';
import Lightbox from '../components/Lightbox.astro';
import { tutteLeFoto } from '../data/foto';

interface Props { lang: Lingua; voce: CollectionEntry<'pagine'> }
const { lang, voce } = Astro.props;
const d = voce.data;
const t = useT(lang);
const { Content } = await render(voce);
const interni = await Promise.all(
  tutteLeFoto.filter((f) => f.area === 'casa' && /-(soggiorno|cucina|cottura|camera)/.test(f.id)).map(async (f) => ({
    ...f,
    // versione grande da aprire nella lightbox
    grande: (await getImage({ src: f.src, width: Math.min(1800, f.src.width), format: 'webp', quality: 72 })).src,
  })),
);
---
<Base lang={lang} pagina="casa" seoTitolo={d.seoTitolo} descrizione={d.descrizione} fotoOg="casa/07-soggiorno-cucina">
  <TestataPagina titolo={d.titolo} intro={d.intro} />
  <section class="sec sec-0">
    <div class="wrap">
      <ul class="griglia griglia-casa">
        {interni.map((f) => (
          <li><a href={f.grande} data-lightbox><Foto id={f.id} lang={lang} sizes="(min-width: 1040px) 25vw, (min-width: 720px) 33vw, 50vw" /></a></li>
        ))}
      </ul>
      <div class="prosa"><Content /></div>
      <div class="dotazioni">
        {d.dotazioni?.map((g) => (
          <section>
            <h2>{g.titolo}</h2>
            <ul>{g.voci.map((v) => <li>{v}</li>)}</ul>
          </section>
        ))}
      </div>
      {d.regole && d.regole.length > 0 && (
        <section class="regole" aria-labelledby="tit-regole">
          <h2 class="h2 h2-piccolo" id="tit-regole">{t('casa.regole')}</h2>
          <ul>{d.regole.map((r) => <li>{r}</li>)}</ul>
        </section>
      )}
      {/* CIN e CIR anche qui, oltre che nel footer (obbligo di legge negli annunci) */}
      <p class="codici">CIN {struttura.cin || t('foot.daFornire')} · CIR {struttura.cir || t('foot.daFornire')}</p>
      <a class="link" href={url('galleria', lang)}>{t('link.galleria')}</a>
    </div>
  </section>
  <Lightbox lang={lang} />
  <ChiamataContatti lang={lang} />
</Base>
