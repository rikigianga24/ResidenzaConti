---
// Layout comune: <head> SEO, header con menu e cambio lingua, footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { lingue, rotte, type Lingua, type Pagina } from '../i18n/ui';

interface Props {
  lang: Lingua;
  pagina: Pagina;
  titolo: string;
  descrizione?: string;
}
const { lang, pagina, titolo, descrizione = '' } = Astro.props;
const titoloCompleto = pagina === 'home' ? titolo : `${titolo} · Residenza Conti`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    {descrizione && <meta name="description" content={descrizione} />}
    <link rel="canonical" href={new URL(rotte[pagina][lang], Astro.site)} />
    {/* hreflang: dice a Google quale pagina corrisponde in ogni lingua */}
    {(Object.keys(lingue) as Lingua[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(rotte[pagina][l], Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(rotte[pagina].it, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Header lang={lang} pagina={pagina} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
