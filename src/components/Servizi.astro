---
// Griglia dei servizi con icone animate (si muovono al passaggio del mouse,
// da sole su telefono). Le icone sono nello stesso ordine dei testi in content/*/home.md.
interface Props { servizi: { titolo: string; testo: string }[] }
const { servizi } = Astro.props;
const s = servizi;
---
<ul class="servizi">
  <li class="tile">
    <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <defs><clipPath id="vasca"><rect x="6" y="18" width="36" height="22" rx="3"></rect></clipPath></defs>
      <rect class="acqua" x="6" y="18" width="36" height="22" rx="3"></rect>
      <g clip-path="url(#vasca)"><path class="a a-onda" d="M0 27 q3 -3 6 0 t6 0 t6 0 t6 0 t6 0 t6 0 t6 0 t6 0 t6 0"></path><path class="a a-onda lenta" d="M0 34 q3 -3 6 0 t6 0 t6 0 t6 0 t6 0 t6 0 t6 0 t6 0 t6 0"></path></g>
      <rect x="6" y="18" width="36" height="22" rx="3"></rect>
      <path d="M30 22 V11 a3 3 0 0 1 6 0 M36 22 V11 M30 15 H36"></path>
    </svg>
    <h3>{s[0].titolo}</h3><p>{s[0].testo}</p>
  </li>
  <li class="tile">
    <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M24 43 V28 M24 34 l-6 -5 M24 31 l6 -6"></path>
      <g class="a a-foglie"><ellipse class="miele" cx="15" cy="24" rx="6" ry="2.6" transform="rotate(-25 15 24)"></ellipse><ellipse cx="33" cy="21" rx="6" ry="2.6" transform="rotate(25 33 21)"></ellipse><ellipse cx="24" cy="14" rx="2.6" ry="6"></ellipse><ellipse class="miele" cx="17" cy="15" rx="5" ry="2.2" transform="rotate(-50 17 15)"></ellipse><ellipse cx="31" cy="12" rx="5" ry="2.2" transform="rotate(45 31 12)"></ellipse></g>
      <path d="M12 43 H36"></path>
    </svg>
    <h3>{s[1].titolo}</h3><p>{s[1].testo}</p>
  </li>
  <li class="tile">
    <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g class="a a-ombra"><path class="miele" d="M8 20 a16 12 0 0 1 32 0 Z"></path><path d="M8 20 a16 12 0 0 1 32 0 Z M18.5 20 a5.5 11 0 0 1 11 0"></path><path d="M24 8 V42"></path></g>
      <path d="M10 42 H38 M26 36 h10 l2 6"></path>
    </svg>
    <h3>{s[2].titolo}</h3><p>{s[2].testo}</p>
  </li>
  <li class="tile">
    <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path class="a a-fiamma miele" d="M19 22 c-4 -4 -2 -9 2 -12 c0 3 2 4 3 5 c1 -2 1 -4 0 -6 c5 3 7 9 2 13 Z"></path>
      <path class="a a-fiamma f2" d="M27 22 c-2 -2 -1 -5 1 -7 c0 2 1 2 2 3 c2 2 1 3 -1 4"></path>
      <path d="M8 24 H40 a16 11 0 0 1 -32 0 Z"></path>
      <path d="M16 33 L12 44 M32 33 L36 44 M24 35 V44"></path>
    </svg>
    <h3>{s[3].titolo}</h3><p>{s[3].testo}</p>
  </li>
  <li class="tile">
    <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g class="a a-auto"><path class="miele" d="M14 22 l3 -7 h14 l3 7 Z"></path><path d="M7 32 v-6 l4 -4 l4 -8 h18 l4 8 l4 4 v6 Z M11 22 H37"></path><circle cx="15" cy="33" r="3.5"></circle><circle cx="33" cy="33" r="3.5"></circle></g>
      <path d="M4 41 H44" stroke-dasharray="4 4"></path>
    </svg>
    <h3>{s[4].titolo}</h3><p>{s[4].testo}</p>
  </li>
  <li class="tile">
    <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle class="miele" cx="24" cy="38" r="3"></circle>
      <path class="a a-arco" d="M17 31 a10 10 0 0 1 14 0"></path>
      <path class="a a-arco d2" d="M11 25 a18 18 0 0 1 26 0"></path>
      <path class="a a-arco d3" d="M5 19 a26 26 0 0 1 38 0"></path>
    </svg>
    <h3>{s[5].titolo}</h3><p>{s[5].testo}</p>
  </li>
  <li class="tile">
    <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path class="a a-vapore" d="M18 19 q-2 -3 0 -6 q2 -3 0 -6"></path>
      <path class="a a-vapore v2" d="M24 19 q-2 -3 0 -6 q2 -3 0 -6"></path>
      <path class="a a-vapore v3" d="M30 19 q-2 -3 0 -6 q2 -3 0 -6"></path>
      <path class="miele" d="M12 30 H36 V36 a5 5 0 0 1 -5 5 H17 a5 5 0 0 1 -5 -5 Z"></path>
      <path d="M10 24 H38 V36 a6 6 0 0 1 -6 6 H16 a6 6 0 0 1 -6 -6 Z M5 27 H10 M38 27 H43"></path>
    </svg>
    <h3>{s[6].titolo}</h3><p>{s[6].testo}</p>
  </li>
  <li class="tile">
    <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g class="a a-versa"><path class="miele" d="M15 30 h8 v12 h-8 Z"></path><path d="M14 43 V24 q0 -4 3 -6 V7 h4 v11 q3 2 3 6 v19 Z"></path></g>
      <path class="vino" d="M31 26 h10 q0 4 -2 6 h-6 q-2 -2 -2 -6 Z"></path>
      <path d="M30 20 h12 q0 11 -6 12 q-6 -1 -6 -12 Z M36 32 V41 M31 42 h10"></path>
    </svg>
    <h3>{s[7].titolo}</h3><p>{s[7].testo}</p>
  </li>
</ul>
