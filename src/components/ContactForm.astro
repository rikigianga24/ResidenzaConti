---
// Form richiesta disponibilità.
// TODO: scegliere il servizio di invio (es. Web3Forms/Formspree/Netlify Forms) e impostare `action`.
import { useT, type Lingua } from '../i18n/ui';

interface Props { lang: Lingua }
const t = useT(Astro.props.lang);
---
<form class="form" method="POST" action="#">
  <label>{t('form.nome')} <input name="nome" required autocomplete="name" /></label>
  <label>{t('form.email')} <input name="email" type="email" required autocomplete="email" /></label>
  <div class="date">
    <label>{t('form.arrivo')} <input name="arrivo" type="date" /></label>
    <label>{t('form.partenza')} <input name="partenza" type="date" /></label>
    <label>{t('form.ospiti')} <input name="ospiti" type="number" min="1" max="6" /></label>
  </div>
  <label>{t('form.messaggio')} <textarea name="messaggio" rows="5"></textarea></label>
  <button class="bottone" type="submit">{t('form.invia')}</button>
</form>

<style>
  .form { display: grid; gap: 1rem; max-width: 40rem; }
  label { display: grid; gap: .25rem; }
  .date { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1rem; }
  input, textarea { font: inherit; padding: .5rem; border: 1px solid var(--c-bordo); border-radius: .25rem; background: #fff; }
</style>
