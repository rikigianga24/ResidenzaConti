---
// Icone piccole a tratto (stesso disegno del prototipo). Decorative: aria-hidden.
interface Props { nome: 'whatsapp' | 'tel' | 'menu' | 'foglia' | 'fogliaNastro' | 'mail' | 'mappa'; class?: string }
const { nome, class: classe } = Astro.props;
---
{nome === 'whatsapp' && (
  <svg class={classe} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19l-4 1z"></path><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.6-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2L9 9.5z"></path></svg>
)}
{nome === 'tel' && (
  <svg class={classe} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg>
)}
{nome === 'mail' && (
  <svg class={classe} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
)}
{nome === 'mappa' && (
  <svg class={classe} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
)}
{nome === 'menu' && (
  <svg class={classe} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
)}
{nome === 'foglia' && (
  <svg class={classe} viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 20C10 14 14 10 20 4"></path><path d="M8 16c-3-1-4-4-3-7 3 0 5 3 3 7z"></path><path d="M13 11c0-3 2-5 5-5 0 3-2 5-5 5z"></path><path d="M12 12c3 0 5 2 5 5-3 0-5-2-5-5z"></path></svg>
)}
{nome === 'fogliaNastro' && (
  <svg class={classe} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3c4 4 4 14 0 18-4-4-4-14 0-18z"></path></svg>
)}
