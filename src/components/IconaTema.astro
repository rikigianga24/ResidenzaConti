---
// Piccoli indicatori grafici dei temi di un itinerario: borghi, cultura, gastronomia, natura.
interface Props { tema: 'borghi' | 'cultura' | 'gastronomia' | 'natura' }
const { tema } = Astro.props;
---
<svg class="ico-tema" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {tema === 'borghi' && <path d="M5 21V10l3-2 3 2v11M11 21V6l3-3 3 3v15M3 21h18M8 14v3M14 11v3" />}
  {tema === 'cultura' && <path d="M3 9l9-5 9 5M5 9v9M9.5 9v9M14.5 9v9M19 9v9M3 21h18M3 18h18" />}
  {tema === 'gastronomia' && <path d="M8 3v7a3 3 0 0 0 3 3h0V21M11 3v7M14 3c2 1 3 3.5 3 6s-1 3-3 3v9" />}
  {tema === 'natura' && <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14M5 19l7-7" />}
</svg>
