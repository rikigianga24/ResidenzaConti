---
// Galleria: carica tutte le immagini in src/assets/galleria e le ottimizza in build
// (ridimensionamento + webp), così non serve ridurle a mano.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { limite?: number; testoVuoto: string }
const { limite, testoVuoto } = Astro.props;

const file = import.meta.glob<{ default: ImageMetadata }>('../assets/galleria/*.{jpg,jpeg,png,webp}', { eager: true });
const immagini = Object.entries(file)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default)
  .slice(0, limite);
---
{immagini.length === 0 ? (
  <p>{testoVuoto}</p>
) : (
  <div class="griglia">
    {immagini.map((img, i) => (
      <a href={img.src} target="_blank" rel="noopener">
        <Image src={img} alt="" widths={[400, 800]} sizes="(max-width: 600px) 100vw, 33vw" loading={i < 3 ? 'eager' : 'lazy'} />
      </a>
    ))}
  </div>
)}

<style>
  .griglia { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: .5rem; }
  .griglia :global(img) { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
</style>
