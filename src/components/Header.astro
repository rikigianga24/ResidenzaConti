---
import Icona from './Icona.astro';
import BottoniContatto from './BottoniContatto.astro';
import { LINGUE, url, type Lingua, type Pagina } from '../i18n/lingue';
import { useT, nomePagina } from '../i18n/ui';

interface Props { lang: Lingua; pagina: Pagina }
const { lang, pagina } = Astro.props;
const t = useT(lang);
// menu principale su desktop (il resto è nel footer e nel menu su telefono)
const principali: Pagina[] = ['casa', 'storia', 'dintorni', 'disponibilita'];
const tutte: Pagina[] = ['home', 'casa', 'galleria', 'storia', 'dintorni', 'disponibilita', 'recensioni', 'arrivare', 'faq', 'contatti'];
const corrente = (p: Pagina) => (p === pagina ? 'page' : undefined);
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a class="brand" href={url('home', lang)}>Residenza Conti</a>
    <nav class="nav" aria-label={t('nav.principale')}>
      {principali.map((p) => <a href={url(p, lang)} aria-current={corrente(p)}>{nomePagina(p, lang)}</a>)}
    </nav>
    <div class="dx">
      <ul class="lang" aria-label={t('nav.lingua')}>
        {LINGUE.map((l) => (
          <li><a href={url(pagina, l)} lang={l} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a></li>
        ))}
      </ul>
      <details class="menu-mob">
        <summary aria-label={t('nav.menu')}><Icona nome="menu" /></summary>
        <nav aria-label={t('nav.principale')}>
          <ul>
            {tutte.map((p) => <li><a href={url(p, lang)} aria-current={corrente(p)}>{nomePagina(p, lang)}</a></li>)}
          </ul>
        </nav>
      </details>
    </div>
    <BottoniContatto lang={lang} class="hdr-cta" />
  </div>
</header>
