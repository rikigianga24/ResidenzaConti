    <g class="f5" transform="translate(206.0 36.6) rotate(-48.5)"><ellipse class="fg" cx="12" cy="0" rx="12" ry="4.2"></ellipse></g>
    <g class="f6" transform="translate(253.5 21.5) rotate(20.4)"><ellipse class="fg" cx="12" cy="0" rx="12" ry="4.2"></ellipse></g>
    <g class="f7" transform="translate(283.2 14.1) rotate(-47.5)"><ellipse class="fg" cx="12" cy="0" rx="12" ry="4.2"></ellipse></g>
