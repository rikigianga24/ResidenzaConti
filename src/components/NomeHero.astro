---
// Nome "Residenza Conti" nell'hero: corsivo, una lettera alla volta, con un ramo
// d'ulivo che cresce sotto. Tutte le animazioni usano solo transform e opacity
// (stili in global.css) e si spengono con prefers-reduced-motion.
const riga1 = 'Residenza'.split('');
const riga2 = 'Conti'.split('');
---
<h1 class="nome" aria-label="Residenza Conti">
  <span class="riga r1" aria-hidden="true">{riga1.map((c) => <span class="l">{c}</span>)}</span>
  <span class="riga r2" aria-hidden="true">{riga2.map((c) => <span class="l">{c}</span>)}</span>
</h1>
<svg class="ramo" viewBox="-6 -10 396 76" fill="none" aria-hidden="true">
  <path class="gambo" d="M4 34 C 70 6, 150 60, 230 30 C 300 2, 330 12, 356 26" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    <g class="f1" transform="translate(24.2 27.9) rotate(-48.9)"><ellipse class="fg" cx="12" cy="0" rx="12" ry="4.2"></ellipse></g>
    <g class="f2" transform="translate(66.8 26.5) rotate(42.9)"><ellipse class="fg" cx="12" cy="0" rx="12" ry="4.2"></ellipse></g>
