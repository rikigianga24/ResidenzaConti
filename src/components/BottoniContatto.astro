---
// Pulsanti WhatsApp + Chiama (prima chiamata all'azione), opzionali email e Booking.com.
import Icona from './Icona.astro';
import { useT } from '../i18n/ui';
import type { Lingua } from '../i18n/lingue';
import { struttura, linkWhatsApp } from '../data/struttura';

interface Props {
  lang: Lingua;
  /** testo lungo sul pulsante WhatsApp */
  lungo?: boolean;
  email?: boolean;
  booking?: boolean;
  class?: string;
}
const { lang, lungo = false, email = false, booking = false, class: classe = 'ctas' } = Astro.props;
const t = useT(lang);
---
<div class={classe}>
  <a class="btn btn-vino" href={linkWhatsApp(t('wa.messaggio'))}><Icona nome="whatsapp" class="ic ic-wa" />{lungo ? t('cta.whatsappLungo') : t('cta.whatsapp')}</a>
  {!booking && <a class="btn btn-filo" href={`tel:${struttura.telefono}`}><Icona nome="tel" class="ic ic-tel" />{t('cta.chiama')}</a>}
  {email && <a class="btn btn-filo" href={`mailto:${struttura.email}`}><Icona nome="mail" class="ic" />{t('cta.email')}</a>}
  {booking && struttura.bookingUrl && <a class="btn btn-filo" href={struttura.bookingUrl} rel="noopener">{t('cta.booking')}</a>}
</div>
